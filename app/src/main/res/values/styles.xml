<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme -->
    <style name="Theme.VidCut" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/vidcut_black</item>
        <item name="android:navigationBarColor">@color/vidcut_black</item>
        <item name="android:windowBackground">@color/vidcut_black</item>
        <item name="colorPrimary">@android:color/white</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Splash theme used by SplashActivity (transparent window + black content base) -->
    <style name="Theme.VidCut.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Compatibility alias for core-splashscreen / older references -->
    <style name="Theme.VidCut.Starting" parent="Theme.VidCut.Splash" />
</resources>
